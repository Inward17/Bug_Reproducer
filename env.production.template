# =====================================================
# AutoRepro — Production Environment Variables
# Copy this to .env.production and fill in the values
# NEVER commit .env.production to git
# =====================================================

# --- LLM Provider (choose one) ---
# Options: bedrock | google | anthropic | openai | ollama | mock
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514

# --- API Keys (only fill in the one you're using) ---
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME
GOOGLE_API_KEY=
OPENAI_API_KEY=

# --- AWS Bedrock (only if LLM_PROVIDER=bedrock) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- App Behaviour ---
MAX_ATTEMPTS=5
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_MB=512
SANDBOX_IMAGE=autorepro-sandbox:latest
DATA_DIR=/app/data
LOG_LEVEL=INFO
DEMO_MODE=false
