# ============================================================================
# AutoRepro — production environment
# Copy to .env.production and fill in. Never commit the filled-in file.
# ============================================================================

# ── LLM provider (pick one) ─────────────────────────────────────────────────
# bedrock | google | anthropic | openai | ollama | auto | mock
LLM_PROVIDER=bedrock
LLM_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0

# AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Google Gemini
# GOOGLE_API_KEY=

# Anthropic
# ANTHROPIC_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# Optional per-stage model overrides; each defaults to LLM_MODEL.
# BEDROCK_MODEL=
# ANTHROPIC_MODEL=
# GOOGLE_MODEL=
# OLLAMA_MODEL=

# ── Access control — set BOTH before exposing this service ─────────────────
# Shared key required in the X-API-Key header. Empty leaves the API open.
API_KEY=
# Comma-separated origins allowed to call the API from a browser. Leave empty
# when the bundled UI is served from this same origin.
CORS_ORIGINS=

# ── Target vetting ──────────────────────────────────────────────────────────
# false refuses targets on private/loopback addresses. Link-local and cloud
# metadata addresses (169.254.0.0/16) are refused either way.
ALLOW_PRIVATE_TARGETS=false

# ── Agent loop ──────────────────────────────────────────────────────────────
MAX_ATTEMPTS=5

# ── Sandbox ─────────────────────────────────────────────────────────────────
SANDBOX_IMAGE=autorepro-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_MB=512
SANDBOX_PIDS_LIMIT=256
# Read-only rootfs + tmpfs. Turn on and run the demo once to confirm your
# Chromium build works with it.
SANDBOX_READ_ONLY=false
# Sandbox containers allowed to run at once.
MAX_CONCURRENT_SANDBOXES=4

# ── Runtime ─────────────────────────────────────────────────────────────────
DATA_DIR=/app/data
LOG_LEVEL=INFO
# Simulates execution without Docker or a browser. Never produces real evidence.
DEMO_MODE=false
